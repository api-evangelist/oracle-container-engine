            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path",
                "description": "OCID of the cluster"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create kubeconfig content"
